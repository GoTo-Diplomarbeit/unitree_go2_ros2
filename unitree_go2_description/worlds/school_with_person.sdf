    </model>

    <!-- A person standing 2 m in front of the robot's spawn point, for testing person
         detection (camera) and dynamic obstacle handling (lidar).
         The robot spawns at x=0, y=0 facing +x (see world_init_x/y/heading in
         unitree_go2_launch.py), so "2 m in front" is x=2, y=0. This is measured from
         the robot's centre - its nose is about 1.7 m away from the person.
         The mesh faces -y on its own; yaw -90 deg turns it to face -x, towards the robot.
         static: the person can't be pushed over or walk around.
         PITFALL: the model is downloaded from Gazebo Fuel on the first start (needs
         internet once), then cached in ~/.gz/fuel. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>person</name>
      <pose>2.0 0 0 0 0 -1.5708</pose>
      <static>true</static>
    </include>

  </world>
</sdf>